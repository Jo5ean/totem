---
import Layout from '../layouts/Layout.astro';
---

<Layout title="UCASAL - Genially">
    <div class="w-full h-screen flex flex-col bg-gray-900">
        <!-- Cabecera -->
        <header class="bg-blue-900 text-white p-4 flex items-center justify-between shadow-lg">
            <div class="flex items-center space-x-4">
                <img src="https://wwwold.ucasal.edu.ar/proyectos-innovalab/web/logos/ucasalx_logo.png" alt="UCASAL Logo" class="h-10" />
            </div>
            <a href="https://wwwold.ucasal.edu.ar/proyectos-innovalab/web/" class="bg-blue-700 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-colors">
                Volver al Inicio
            </a>
        </header>

        <!-- Contenedor principal con iframe -->
        <div class="flex-1 w-full">
            <iframe 
                src="https://view.genially.com/664baa5384877200141034dd" 
                class="w-full h-full border-none"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
            ></iframe>
        </div>

        <!-- Footer -->
        <footer class="bg-blue-900 text-white p-2 text-center text-sm">
            © 2025 Universidad Católica de Salta - Todos los derechos reservados
        </footer>
    </div>
</Layout>

<script>
    // Script para manejar posibles errores de carga del iframe
    document.addEventListener('DOMContentLoaded', () => {
        const iframe = document.querySelector('iframe');
        
        // Verificar que el iframe existe antes de continuar
        if (!iframe) {
            console.error('❌ No se encontró el elemento iframe');
            return;
        }
        
        // Función para verificar si el iframe cargó correctamente
        const checkIframeLoaded = () => {
            try {
                // Intentar acceder al contenido del iframe
                // Si hay error de seguridad por CORS, esto fallará silenciosamente
                const iframeContent = iframe.contentDocument || (iframe.contentWindow && iframe.contentWindow.document);
                console.log('✅ Iframe cargado correctamente');
            } catch (error) {
                console.log('⚠️ No se puede verificar el contenido del iframe debido a restricciones CORS');
            }
        };

        // Verificar cuando el iframe termine de cargar
        iframe.addEventListener('load', checkIframeLoaded);
        
        // También verificar después de un tiempo por si acaso
        setTimeout(checkIframeLoaded, 5000);
    });
</script>
